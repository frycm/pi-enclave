{
	"name": "pi-enclave",
	"version": "0.1.0",
	"description": "Sandbox-first auto mode for pi",
	"type": "module",
	"license": "MIT",
	"main": "./src/index.ts",
	"bin": {
		"pi-enclave": "./bin/pi-enclave.mjs"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "tsc --noEmit && biome check src test bin scripts",
		"format": "biome check --write src test bin scripts",
		"test": "vitest --run",
		"test:unit": "vitest --run test/unit",
		"test:conformance": "vitest --run --passWithNoTests test/conformance",
		"test:policy": "vitest --run test/policy",
		"probe": "node --import tsx scripts/probe.ts",
		"conformance:report": "node --import tsx scripts/conformance-report.ts",
		"policy:report": "node --import tsx scripts/policy-report.ts",
		"bench:fs": "node --import tsx scripts/fs-bench.ts",
		"enclave": "node bin/pi-enclave.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0 <1.2.0"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.79",
		"@earendil-works/pi-ai": "1.1.0",
		"tsx": "4.23.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@types/node": "22.20.5",
		"fast-check": "4.10.2",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"files": [
		"src",
		"bin",
		"README.md",
		"LICENSE"
	]
}
