{
	"name": "pi-enclave",
	"version": "0.1.0",
	"description": "Sandbox-first auto mode for pi",
	"type": "module",
	"license": "MIT",
	"main": "./src/index.ts",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"engines": {
		"node": ">=20.11.0"
	},
	"scripts": {
		"check": "tsc --noEmit && biome check src test",
		"format": "biome check --write src test",
		"test": "vitest --run",
		"test:unit": "vitest --run test/unit",
		"test:conformance": "vitest --run --passWithNoTests test/conformance",
		"probe": "tsx scripts/probe.ts",
		"conformance:report": "tsx scripts/conformance-report.ts",
		"bench:fs": "tsx scripts/fs-bench.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.84.2 <0.85.0"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.73"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@types/node": "22.10.2",
		"tsx": "4.19.2",
		"typescript": "5.7.2",
		"vitest": "2.1.8"
	}
}
