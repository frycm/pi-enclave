# Trusted test fixture only. The runtime never builds or pulls a project image.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
RUN apt-get update && apt-get install -y --no-install-recommends bash git python3 ripgrep fd-find file util-linux sudo \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*
# These must disappear from both shell and helper through the env -i launcher.
ENV IMAGE_ONLY_SECRET=IMAGE-ENV-MUST-NOT-LEAK
ENV ANTHROPIC_API_KEY=IMAGE-KEY-MUST-NOT-LEAK
ENTRYPOINT ["/bin/false"]
WORKDIR /unexpected-image-cwd
