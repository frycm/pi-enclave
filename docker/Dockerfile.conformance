# Explicit CI fixture build; production never builds or pulls project Dockerfiles.
FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d
RUN apt-get update && apt-get install -y --no-install-recommends git python3 curl ripgrep fd-find util-linux \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*
ENV IMAGE_ONLY_SECRET=IMAGE_ENV_MUST_NOT_REACH_CHILD
WORKDIR /unexpected-image-cwd
ENTRYPOINT ["/bin/false"]
